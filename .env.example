NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:password@localhost:5432/boostpanel
# Set true for Supabase (or another PostgreSQL server that requires TLS)
PGSSL=false
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Supplier adapter (generic REST; adapt endpoints and payload to supplier docs)
SUPPLIER_API_URL=
SUPPLIER_API_KEY=
SUPPLIER_SERVICES_PATH=/services
SUPPLIER_ORDER_PATH=/orders
SUPPLIER_STATUS_PATH=/orders
